rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /testCollection/{docId} {
      allow read, write: if true;
    }
    match /consultLogs/{id} {
      allow read, write: if true;
    }
    match /consultSummary/{id} {
      allow read, write: if true;
    }
    match /consultDaily/{id} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /clients/{clientId} {
      allow read, write: if true;
    }
    match /projects/{projectId} {
      allow read, write: if true;
    }
    match /records/{recordId} {
      allow read, write: if true;
    }
    match /quotes/{quoteId} {
      allow read, write: if true;
    }
    match /settles/{id} {
      allow read, write: if true;
    }
    match /depositHistory/{id} {
      allow read, write: if true;
    }
    match /depositUnmatched/{id} {
      allow read, write: if true;
    }
    match /depNames/{id} {
      allow read, write: if true;
    }
    match /dailySettleRows/{id} {
      allow read, write: if true;
    }
    match /bankTransactions/{id} {
      allow read, write: if true;
    }
    match /companyExpenses/{id} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if docId in ['gsync', 'monthlyCnt', 'uiCols', 'gsyncLock'];
    }
    match /blogProjects/{id} {
      allow read, write: if true;
    }
    match /payRecords/{id} {
      allow read, write: if true;
    }
    match /payHistory/{id} {
      allow read, write: if true;
    }
    match /taxInvoiceBatches/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
